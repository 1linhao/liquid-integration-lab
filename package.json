{
  "name": "@liqui/integration-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "LiquidUI 与 LiquidAppShell 的跨主题、跨视口独立消费端和视觉发布门槛。",
  "repository": { "type": "git", "url": "git+https://github.com/1linhao/liquid-integration-lab.git" },
  "homepage": "https://1linhao.github.io/liquid-integration-lab/",
  "type": "module",
  "scripts": {
    "dev": "vite --force --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "check": "npm run build && npm run test:visual"
  },
  "dependencies": {
    "@liqui/liquid-app-shell": "file:../liquid-app-shell",
    "@liqui/liquid-ui": "file:../liquid-ui",
    "vue": "2.7.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.3"
  }
}
